<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore from nuget.org only. Ignores the feeds declared in the machine-wide NuGet config
    (such as the Gurren GitHub Packages feed used to install this template): with central
    package management, a second feed without source mapping fails the restore (NU1507).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
